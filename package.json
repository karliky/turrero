    "ai-local": "tsx scripts/local-ai-enrichment.ts",
    "graph": "python scripts/create_graph.py",
    "export-obsidian": "tsx scripts/export-turra-obsidian.ts",
    "export-obsidian-all": "tsx scripts/export-obsidian-all.ts",
    "pdf": "tsx scripts/generate-pdf.ts",
    "podcast": "tsx scripts/tweet-to-podcast.ts",
