# Copy to .env.local and fill in. Only needed to add or refresh turras.

# X API v2 app-only bearer token (https://console.x.com). Used by turra:add and turra:sync.
X_API_BEARER_TOKEN=

# OpenAI API key for the AI enrichment (title, categories, exam). Optional for turra:add.
OPENAI_API_KEY=
# Optional model override (default: gpt-5.4-mini)
OPENAI_MODEL=
